{
  "name": "cross-examination",
  "version": "0.1.0",
  "description": "Counsel-only local desktop app for litigation oral exam practice with xAI Grok Voice",
  "private": true,
  "author": "Tom Cedoz",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "node scripts/clean-build-output.mjs && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "package:dir": "npm run build && electron-builder --dir --win --x64 --config electron-builder.yml",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "package:qa": "npm run package:dir && npm run verify:package && npm run smoke:package",
    "release:win": "npm run check && electron-builder --win nsis --x64 --config electron-builder.release.yml && npm run verify:package && npm run smoke:package",
    "pretest": "node scripts/ensure-no-mcps.mjs",
    "hygiene": "node scripts/ensure-no-mcps.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "mammoth": "^1.9.0",
    "minisearch": "^7.1.2",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@electron/asar": "4.2.0",
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.6",
    "wait-on": "^8.0.3"
  }
}
